:3081 {
	root * dist

	# Match requests with trailing slashes and rewrite them
	@trailing_slash {
		path_regexp strip_slash ^(.+)/$ # Match paths ending with /
	}
	rewrite @trailing_slash {re.strip_slash.1} # Remove the trailing slash

	try_files {path}.html {path}/index.html {path}
	encode zstd gzip
	file_server

	# Cache policy is honest about filenames: everything below is
	# content-addressed — generated images and vendored assets are
	# filename-versioned, and CSS is content-hashed by `just tailwind_build`
	# (styles/output.<hash>.css, referenced by the prod server). HTML is the
	# only constant URL and always revalidates.
	@static_assets {
		path_regexp static_assets \.(css|jpg|jpeg|png|gif|svg|ico|mp4|webm|woff|woff2|eot|ttf|otf|js|avif|webp)$
	}
	header @static_assets Cache-Control "public, max-age=31536000, immutable"

	# HTML (and everything else without an extension match): always revalidate
	header ?Cache-Control "no-cache"

	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		rewrite @404 /not-found.html
		file_server
	}
}

