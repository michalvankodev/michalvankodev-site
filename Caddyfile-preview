:3081 {
	root * dist

	# Match requests with trailing slashes and rewrite them
	@trailing_slash {
		path_regexp strip_slash ^(.+)/$ # Match paths ending with /
	}
	rewrite @trailing_slash {re.strip_slash.1} # Remove the trailing slash

	try_files {path}.html {path}/index.html {path}
	encode zstd gzip
	file_server

	# Cache policy is honest about filenames: generated images and vendored
	# assets are effectively filename-versioned and cache well; CSS is a
	# constant filename that changes on every deploy, so it must always
	# revalidate (cheap etag 304s). HTML revalidates too.
	@css {
		path_regexp css \.css$
	}
	header @css Cache-Control "no-cache"

	@static_assets {
		path_regexp static_assets \.(jpg|jpeg|png|gif|svg|ico|mp4|webm|woff|woff2|eot|ttf|otf|js|avif|webp)$
	}
	header @static_assets Cache-Control "public, max-age=2592000"

	# HTML (and everything else without an extension match): always revalidate
	header ?Cache-Control "no-cache"

	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		rewrite @404 /not-found.html
		file_server
	}
}

